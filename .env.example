# Frontend (safe to expose — access is enforced by Postgres grants and RLS)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.<region>.aws.neon.tech/neondb/rest/v1

# Server-side only (Vercel project environment variables / .env.local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Email notifications (Resend)
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=owner@example.com

# SMS notifications (ClickSend)
CLICKSEND_USERNAME=your-clicksend-username
CLICKSEND_API_KEY=your-clicksend-api-key
CLICKSEND_FROM=DriveTaxi
AUTO_SMS_ENABLED=true
